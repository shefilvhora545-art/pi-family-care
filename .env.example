# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit ".env": it is listed in .gitignore.

# ---- PostgreSQL ----
# The database is created for you by "npm run setup" if it does not exist.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/pi_family_care

# ---- PayPal (sandbox) ----
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---- Google Gemini (reads the prescription photo) ----
# Free key: aistudio.google.com -> Get API key. Leave empty to use the
# clearly-labelled demo reader (works only with docs/sample-prescription.png).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- App ----
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
# Rupees per US dollar used to show and charge USD prices.
INR_PER_USD=84
